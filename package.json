    "vite:build": "vite build",
    "tauri": "tauri",
    "check": "greenly",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "react-doctor": "react-doctor --verbose",
    "db:generate": "drizzle-kit generate"
