{
  "name": "tidra",
  "version": "0.1.1",
  "private": true,
  "description": "Keep every project you maintain up to date from one desktop app.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "pnpm --env-file .env.local tauri build",
